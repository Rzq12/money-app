{
  "appId": "com.kasku.plus",
  "appName": "Kasku+",
  "webDir": "dist",
  "backgroundColor": "#fafafa",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scheme": "Kasku+"
  },
  "plugins": {
