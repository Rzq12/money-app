{
  "name": "kasku-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/icons.mjs && vite build",
    "check:icons": "node scripts/check-icons.mjs",
    "check:emoji": "node scripts/check-emoji.mjs",
    "build:dev": "node scripts/icons.mjs && vite build --mode development",
    "mobile:sync": "npm run build && cap sync",
    "mobile:sync:dev": "npm run build:dev && cap sync",
    "android:dev": "npm run mobile:sync:dev && cap open android",
    "ios:dev": "npm run mobile:sync:dev && cap open ios",
    "mobile:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#171717\" --iconBackgroundColorDark \"#171717\" --splashBackgroundColor \"#171717\" --splashBackgroundColorDark \"#171717\"",
    "android": "npm run mobile:sync && cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "ios": "npm run mobile:sync && cap open ios",
    "ios:run": "npm run mobile:sync && cap run ios",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
