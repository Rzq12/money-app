# Supabase project used by Kasku+ (Project Settings > API). The anon key is public by design.
# Copy to one file per database (both are gitignored):
#   .env.development  dev DB: `vite` dev server, `npm run build:dev`, `npm run mobile:sync:dev`
#   .env.production   prod DB: `npm run build`, `npm run mobile:sync`
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
